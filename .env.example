# =============================================================================
# Meesho Telugu Fashion Channel Automation - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual credentials
# NEVER commit .env to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# Google Gemini API (Free Tier) - REQUIRED
# Get API key from: https://aistudio.google.com/apikey
# -----------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts

# -----------------------------------------------------------------------------
# Google OAuth / YouTube Data API v3 - REQUIRED for YouTube uploads
# Create OAuth credentials at: https://console.cloud.google.com/
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REFRESH_TOKEN=your_google_refresh_token_here
YOUTUBE_UPLOAD_SCOPE=https://www.googleapis.com/auth/youtube.upload

# -----------------------------------------------------------------------------
# Meta / Instagram Graph API - REQUIRED for Instagram uploads
# Create app at: https://developers.facebook.com/
# -----------------------------------------------------------------------------
META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here
META_PAGE_ACCESS_TOKEN=your_long_lived_page_access_token_here
META_PAGE_ID=your_facebook_page_id_here
META_IG_USER_ID=your_instagram_business_account_id_here
META_GRAPH_API_VERSION=v27.0
META_WEBHOOK_VERIFY_TOKEN=your_random_webhook_verify_token_here

# -----------------------------------------------------------------------------
# Cloudflare Tunnel / Public HTTPS - REQUIRED for Instagram video URLs
# Run: cloudflared tunnel --url http://localhost:8000
# -----------------------------------------------------------------------------
PUBLIC_BASE_URL=https://your-subdomain.trycloudflare.com
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
ADMIN_API_TOKEN=replace_with_a_long_random_value

# -----------------------------------------------------------------------------
# Cloudflare R2 - Public video hosting for GitHub Actions / Instagram
# -----------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=https://media.example.com
R2_OBJECT_PREFIX=videos
R2_STATE_BUCKET_NAME=
R2_STATE_OBJECT_KEY=pipeline.db
R2_STATE_ACCESS_KEY_ID=
R2_STATE_SECRET_ACCESS_KEY=

# -----------------------------------------------------------------------------
# Database & Storage
# -----------------------------------------------------------------------------
DATABASE_PATH=data/pipeline.db
MEDIA_DIR=output
ASSETS_DIR=assets

# -----------------------------------------------------------------------------
# Meesho Scraping Configuration
# -----------------------------------------------------------------------------
MEESHO_BASE_URL=https://www.meesho.com
MEESHO_CATEGORIES=kurtis,sarees,ethnic-sets,western-wear,handbags
MEESHO_MAX_PRODUCTS_PER_CATEGORY=20
MEESHO_SCRAPE_DELAY_MS=2000
MEESHO_REQUEST_TIMEOUT_MS=30000

# Innerwear exclusion keywords (case-insensitive, partial match)
# DO NOT MODIFY unless you understand the filtering logic
INNERWEAR_EXCLUDE_KEYWORDS=bra,panty,briefs,boxer,lingerie,nightwear,sleepwear,innerwear,underwear,bikini,thong,g-string,shapewear

# -----------------------------------------------------------------------------
# Script Generation (Gemini)
# -----------------------------------------------------------------------------
SCRIPT_TARGET_WORDS_MIN=65
SCRIPT_TARGET_WORDS_MAX=80
SCRIPT_TARGET_DURATION_SEC=25
SCRIPT_TEMPERATURE=0.7
SCRIPT_MAX_TOKENS=500

# -----------------------------------------------------------------------------
# TTS Configuration (Gemini API; included in limited free-tier usage)
# Voices: Kore (female), Puck (male)
# -----------------------------------------------------------------------------
TTS_VOICE=Kore

# -----------------------------------------------------------------------------
# Video Builder Configuration
# -----------------------------------------------------------------------------
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
VIDEO_TARGET_DURATION_SEC=25
VIDEO_CODEC=libx264
VIDEO_CRF=20
VIDEO_PRESET=medium
VIDEO_PIX_FMT=yuv420p

# Subtitle settings
SUBTITLE_FONT_SIZE=48
SUBTITLE_COLOR=white
SUBTITLE_OUTLINE_COLOR=black
SUBTITLE_OUTLINE_WIDTH=3
SUBTITLE_SAFE_ZONE_TOP=0.15
SUBTITLE_SAFE_ZONE_BOTTOM=0.85
SUBTITLE_MAX_CHARS_PER_LINE=35
SUBTITLE_MAX_LINES=2

# Ken Burns effect
KEN_BURNS_ZOOM_MIN=1.0
KEN_BURNS_ZOOM_MAX=1.15
KEN_BURNS_PAN_RANGE=0.1

# Background Music
BGM_DIR=assets/bgm
BGM_VOLUME_DB=-18  # BGM at ~14% volume under voiceover

# Audio ducking (sidechain compression)
DUCK_THRESHOLD_DB=-20
DUCK_RATIO=4:1
DUCK_ATTACK_MS=10
DUCK_RELEASE_MS=100

# -----------------------------------------------------------------------------
# YouTube Upload Configuration
# -----------------------------------------------------------------------------
MAX_YT_UPLOADS_PER_DAY=5
YT_QUOTA_LIMIT_DAILY=10000
YT_QUOTA_PER_UPLOAD=1600
YT_CATEGORY_ID=22  # People & Blogs
YT_PRIVACY_STATUS=public
YT_TAGS=fashion,telugu,meesho,womenswear,shorts
YT_DESCRIPTION_TEMPLATE=Check out this amazing {category} from Meesho! 💃\n\nProduct: {title}\nPrice: ₹{price} (MRP ₹{original_price}, {discount}% OFF)\nFabric: {fabric}\nColor: {color}\nCode: {product_code}\n\n🔗 Buy here: {affiliate_url}\n\n#fashion #telugu #meesho #womensfashion #shorts

# -----------------------------------------------------------------------------
# Instagram Upload Configuration
# -----------------------------------------------------------------------------
MAX_IG_UPLOADS_PER_DAY=10
IG_MEDIA_TYPE=REELS
IG_SHARE_TO_FEED=false
IG_CAPTION_TEMPLATE=ఇదే అదभుతమైన {category}! 💃\n\nఉత్పత్తి: {title}\nధర: ₹{price} (MRP ₹{original_price}, {discount}% छूट)\nجينس: {fabric}\nరంగు: {color}\nకోడ్: {product_code}\n\n🔗 లింక్ కోసం "LINK" కమెంట్ చేయండి - మాకు DM історiyle!\n\n#fashion #telugu #meesho #womensfashion #reels #కూర్తీ #సారీ

# -----------------------------------------------------------------------------
# Scheduler / Pipeline Configuration
# -----------------------------------------------------------------------------
POST_INTERVAL_MINUTES=15
PIPELINE_DRY_RUN=false
MAX_CONSECUTIVE_ERRORS=5
HEALTH_CHECK_INTERVAL_MINUTES=5

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=logs/pipeline.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# -----------------------------------------------------------------------------
# Affiliate / Meesho Partner
# -----------------------------------------------------------------------------
MEESHO_AFFILIATE_ID=your_affiliate_id_here
MEESHO_AFFILIATE_BASE_URL=https://meesho.com